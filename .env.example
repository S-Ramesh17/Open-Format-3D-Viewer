# ==========================================
# DATABASE
# ==========================================

# Async URL — used by FastAPI (asyncpg driver)
DATABASE_URL=postgresql+asyncpg://openformat:devpassword@localhost:5432/openformat_dev

# Sync URL — used by Alembic only (psycopg2 driver)
DATABASE_URL_SYNC=postgresql://openformat:devpassword@localhost:5432/openformat_dev

# ==========================================
# SECURITY
# ==========================================

# Must be a long random string — generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace_with_secure_secret_min_32_chars

# ==========================================
# JWT
# ==========================================

ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# ==========================================
# REDIS
# ==========================================

REDIS_URL=redis://localhost:6379/0

# ==========================================
# CORS
# ==========================================

# Comma-separated list of allowed frontend origins — no wildcards
ALLOWED_ORIGINS=http://localhost:3000

# ==========================================
# GOOGLE OAUTH
# ==========================================

GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# ==========================================
# ENVIRONMENT
# ==========================================

ENVIRONMENT=development