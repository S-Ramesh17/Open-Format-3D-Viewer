# ─── Database ─────────────────────────────────────────────────────────────
# Sync psycopg2 dialect used at runtime by Celery processing tasks
DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/openformat

# ─── Redis / Celery broker ─────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── AWS / S3 ──────────────────────────────────────────────────────────────
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_RAW_BUCKET=openformat-raw
S3_PROCESSED_BUCKET=openformat-processed
CDN_BASE_URL=https://cdn.example.com

# ─── Storage provider ──────────────────────────────────────────────────────
STORAGE_PROVIDER=local
LOCAL_STORAGE_PATH=/data/openformat

# ─── XKT conversion (IFC pipeline) ────────────────────────────────────────
XEOKIT_CONVERT_BIN=xeokit-convert
XKT_CHUNK_MAX_BYTES=16777216

# ─── GLTF/GLB pipeline tools ──────────────────────────────────────────────
GLTF_PIPELINE_BIN=gltf-pipeline
GLTF_VALIDATOR_BIN=gltf-validator

# ─── ClamAV (scan queue) ──────────────────────────────────────────────────
CLAMD_HOST=localhost
CLAMD_PORT=3310
CLAMD_TIMEOUT=60

# ─── Observability ─────────────────────────────────────────────────────────
ENVIRONMENT=development
SENTRY_DSN=
METRICS_PORT=9090
MAX_UPLOAD_SIZE_BYTES=524288000