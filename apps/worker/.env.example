# ─── Database ─────────────────────────────────────────────────────────────
# Sync psycopg2 dialect (postgresql+psycopg2:// or plain postgresql://)
# The worker replaces asyncpg:// with psycopg2:// at runtime — both forms work.
DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/openformat

# ─── Redis / Celery broker ─────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── AWS / S3 ──────────────────────────────────────────────────────────────
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_RAW_BUCKET=openformat-raw
S3_PROCESSED_BUCKET=openformat-processed
CDN_BASE_URL=https://cdn.example.com

# ─── Storage provider ──────────────────────────────────────────────────────
# TEMP LOCAL STORAGE — change to "s3" when AWS credentials are available
STORAGE_PROVIDER=local
LOCAL_STORAGE_PATH=/tmp/openformat_uploads

# ─── XKT conversion (IFC pipeline) ────────────────────────────────────────
# Binary name or path to @xeokit/xeokit-convert CLI
# Install: npm install -g @xeokit/xeokit-convert
XEOKIT_CONVERT_BIN=xeokit-convert
XKT_CHUNK_MAX_BYTES=16777216

# ─── GLTF/GLB pipeline tools ──────────────────────────────────────────────
# Install: npm install -g gltf-pipeline gltf-validator
GLTF_PIPELINE_BIN=gltf-pipeline
GLTF_VALIDATOR_BIN=gltf-validator

# ─── ClamAV (scan queue) ──────────────────────────────────────────────────
# CLAMD_HOST and CLAMD_PORT are used by the scan task (clamd TCP socket).
# CLAMD_TIMEOUT controls stream scan timeout in seconds.
CLAMD_HOST=localhost
CLAMD_PORT=3310
CLAMD_TIMEOUT=60

# ─── Observability ─────────────────────────────────────────────────────────
ENVIRONMENT=development
SENTRY_DSN=

WORKER_METRICS_PORT=9090
MAX_UPLOAD_SIZE_BYTES=524288000