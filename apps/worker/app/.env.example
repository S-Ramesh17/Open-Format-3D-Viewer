# Redis broker + result backend
REDIS_URL=redis://localhost:6379/0

# PostgreSQL (sync psycopg2 driver for Celery tasks)
DATABASE_URL=postgresql+psycopg2://openformat:devpassword@localhost:5432/openformat_dev

# AWS / S3
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_RAW_BUCKET=openformat-raw
S3_PROCESSED_BUCKET=openformat-processed
CDN_BASE_URL=https://cdn.example.com

# XKT conversion
# Path to @xeokit/xeokit-convert CLI binary or node script
# Install: npm install -g @xeokit/xeokit-convert
XEOKIT_CONVERT_BIN=xeokit-convert

# Max XKT chunk size in bytes (default: 16 MB)
XKT_CHUNK_MAX_BYTES=16777216

# Observability
ENVIRONMENT=development
SENTRY_DSN=
