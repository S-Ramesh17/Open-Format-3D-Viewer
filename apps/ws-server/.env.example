# ─── WebSocket Server Config ──────────────────────────────────────────────
PORT=8001

# ─── JWT Secret ───────────────────────────────────────────────────────────
# IMPORTANT: Must be kept completely identical to the API's SECRET_KEY
JWT_SECRET=CHANGE_ME_TO_A_RANDOM_64_CHAR_HEX_STRING

# ─── Redis ─────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── Logging ───────────────────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=info 

# ─── Metrics ───────────────────────────────────────────────────────────────
WS_METRICS_PORT=9091

# ─── Internal API authorization (JOIN_MODEL) ──────────────────────────────
# Used to verify a connected user actually has project/model membership
# before letting them join a model's collaboration room. Must match the
# API's INTERNAL_SERVICE_KEY exactly. If either is unset, all JOIN_MODEL
# requests fail closed (MODEL_ACCESS_DENIED).
WS_INTERNAL_API_URL=http://localhost:8000
WS_INTERNAL_SERVICE_KEY=CHANGE_ME_TO_A_RANDOM_SECRET