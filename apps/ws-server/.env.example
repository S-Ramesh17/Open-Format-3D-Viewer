# ─── WebSocket Server Config ──────────────────────────────────────────────
PORT=8001

# ─── JWT Secret ───────────────────────────────────────────────────────────
# IMPORTANT: JWT_SECRET MUST equal the API service's SECRET_KEY exactly.
# Both services sign and verify tokens with the same HMAC-SHA256 secret.
# In production, set this from the same secret source as the API's SECRET_KEY.
# Option A (recommended): rename to SECRET_KEY here and read process.env.SECRET_KEY
#   in server.js — removes the possibility of mismatch entirely.
# Option B: set JWT_SECRET = the value of API's SECRET_KEY.
JWT_SECRET=CHANGE_ME_TO_A_RANDOM_64_CHAR_HEX_STRING

# ─── Redis ─────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── Logging ───────────────────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=info

WS_METRICS_PORT=9091