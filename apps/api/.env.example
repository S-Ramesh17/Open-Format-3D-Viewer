# ─── Database ─────────────────────────────────────────────────────────────
# asyncpg dialect required for the FastAPI service
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/openformat

# ─── Auth / JWT ────────────────────────────────────────────────────────────
# SECRET_KEY is used to sign JWTs in this API service
# Must be kept identical to the ws-server's JWT_SECRET string in production
SECRET_KEY=CHANGE_ME_TO_A_RANDOM_64_CHAR_HEX_STRING

ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# ─── Redis ─────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── AWS / S3 ──────────────────────────────────────────────────────────────
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_RAW_BUCKET=openformat-raw
S3_PROCESSED_BUCKET=openformat-processed
CDN_BASE_URL=https://cdn.example.com

# ─── Storage provider ──────────────────────────────────────────────────────
# Options: "local" (dev/test on local disk) or "s3" (AWS production storage)
STORAGE_PROVIDER=local
LOCAL_STORAGE_PATH=/data/openformat

# ─── Google OAuth ──────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/v1/auth/google/callback

# ─── CORS ──────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# ─── Rate limiting ─────────────────────────────────────────────────────────
RATE_LIMIT_FREE_PER_HOUR=100
RATE_LIMIT_PRO_PER_HOUR=10000

# ─── Upload limits ─────────────────────────────────────────────────────────
MAX_UPLOAD_SIZE_BYTES=524288000

# ─── Observability ─────────────────────────────────────────────────────────
ENVIRONMENT=development
SENTRY_DSN=
APP_VERSION=0.1.0

# ─── Prometheus metrics ───────────────────────────────────────────────────
WORKER_METRICS_PORT=9090
WS_METRICS_PORT=9091