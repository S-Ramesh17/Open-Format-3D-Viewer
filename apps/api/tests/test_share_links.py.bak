import uuid
from datetime import datetime, timedelta, timezone

import pytest
from httpx import AsyncClient

from app.models.model import Model
from app.models.model_metadata import ModelMetadata
from app.models.share_link import ShareLink
from app.models.project import Project
from app.models.project_member import ProjectMember
from app.models.user import User


@pytest.fixture
async def share_test_data(db_session):
    # Create user
    user = User(id=uuid.uuid4(), email=f"owner_{uuid.uuid4().hex[:8]}@test.com", password_hash="hash", full_name="Owner")
    db_session.add(user)
    
    # Create another user for permission testing
    viewer = User(id=uuid.uuid4(), email=f"viewer_{uuid.uuid4().hex[:8]}@test.com", password_hash="hash", full_name="Viewer")
    db_session.add(viewer)
    await db_session.flush()

    # Create project + membership
    project = Project(id=uuid.uuid4(), name="Share Proj", owner_id=user.id)
    db_session.add(project)
    await db_session.flush()

    member_owner = ProjectMember(project_id=project.id, user_id=user.id, role="admin")
    db_session.add(member_owner)
    member_viewer = ProjectMember(project_id=project.id, user_id=viewer.id, role="viewer")
    db_session.add(member_viewer)

    # Create Model
    model = Model(
        id=uuid.uuid4(),
        project_id=project.id,
        uploaded_by=user.id,
        name="Test Model",
        original_filename="test.ifc",
        file_format="ifc",
        file_size_bytes=1000,
        s3_raw_key="raw/123",
        status="ready"
    )
    db_session.add(model)
    await db_session.flush()

    # Create Metadata mimicking successful worker completion
    meta = ModelMetadata(
        model_id=model.id,
        properties={"xkt_chunks": ["processed/123_part0.xkt", "processed/123_part1.xkt"]},
        spatial_tree={}
    )
    db_session.add(meta)

    await db_session.commit()
    return {"owner": user, "viewer": viewer, "project": project, "model": model}


@pytest.mark.asyncio
async def test_create_share_link(client: AsyncClient, share_test_data):
    owner = share_test_data["owner"]
    model = share_test_data["model"]
    
    from app.core.security import create_access_token
    token = create_access_token(str(owner.id))

    response = await client.post(
        "/v1/share",
        json={"model_id": str(model.id)},
        headers={"Authorization": f"Bearer {token}"}
    )
    
    assert response.status_code == 201
    data = response.json()["data"]
    assert "token" in data
    assert data["model_id"] == str(model.id)


@pytest.mark.asyncio
async def test_resolve_public_share_link(client: AsyncClient, db_session, share_test_data):
    model = share_test_data["model"]
    owner = share_test_data["owner"]

    # Pre-seed a share link
    link = ShareLink(
        id=uuid.uuid4(),
        model_id=model.id,
        created_by=owner.id,
        token=f"public-test-{uuid.uuid4().hex[:8]}",
        revoked=False
    )
    db_session.add(link)
    await db_session.commit()

    # Access without ANY auth headers
    response = await client.get(f"/v1/share/{link.token}")
    assert response.status_code == 200
    data = response.json()["data"]
    
    assert data["link"]["token"] == link.token
    assert data["model"]["id"] == str(model.id)
    # Ensure sensitive fields are excluded
    assert "project_id" not in data["model"]
    assert "uploaded_by" not in data["model"]
    # Ensure chunk URLs were fetched and hydrated
    assert len(data["model"]["chunk_urls"]) == 2
    assert "processed/123_part0.xkt" in data["model"]["chunk_urls"][0]


@pytest.mark.asyncio
async def test_expired_share_link_rejected(client: AsyncClient, db_session, share_test_data):
    model = share_test_data["model"]
    
    link = ShareLink(
        id=uuid.uuid4(),
        model_id=model.id,
        created_by=share_test_data["owner"].id,
        token=f"expired-token-{uuid.uuid4().hex[:8]}",
        expires_at=datetime.now(timezone.utc) - timedelta(days=1),
        revoked=False
    )
    db_session.add(link)
    await db_session.commit()

    response = await client.get(f"/v1/share/{link.token}")
    assert response.status_code == 400 # ValidationException in service
    assert "expired" in response.json()["error"]["message"].lower()


@pytest.mark.asyncio
async def test_revoke_share_link_by_non_owner(client: AsyncClient, db_session, share_test_data):
    owner = share_test_data["owner"]
    viewer = share_test_data["viewer"]
    model = share_test_data["model"]

    link = ShareLink(
        id=uuid.uuid4(),
        model_id=model.id,
        created_by=owner.id,
        token=f"revoke-test-{uuid.uuid4().hex[:8]}",
    )
    db_session.add(link)
    await db_session.commit()

    from app.core.security import create_access_token
    viewer_token = create_access_token(str(viewer.id))

    response = await client.delete(
        f"/v1/share/{link.id}",
        headers={"Authorization": f"Bearer {viewer_token}"}
    )
    assert response.status_code == 403 # AuthorizationException in service