# ─── Python ────────────────────────────────────────────────────────────────
**/__pycache__/
**/*.py[cod]
**/*.pyo
**/*.pyd
**/.Python
**/*.egg
**/*.egg-info/
**/.eggs/
**/dist/
**/build/
**/.venv/
**/.env

# .env.example files MUST be committed (they are documentation, not secrets)
# The line above excludes .env (real secrets); .env.example is committed.

# ─── Poetry ────────────────────────────────────────────────────────────────
# poetry.lock is intentionally committed — it ensures reproducible installs.
# Do NOT add poetry.lock here.

# ─── Node ──────────────────────────────────────────────────────────────────
**/node_modules/
**/.npm/
**/npm-debug.log*
**/yarn-debug.log*
**/yarn-error.log*

# ─── Testing ───────────────────────────────────────────────────────────────
**/.pytest_cache/
**/.coverage
**/coverage.xml
**/htmlcov/
**/.mypy_cache/
**/.ruff_cache/

# ─── Build artifacts ───────────────────────────────────────────────────────
**/dist/
**/build/
**/*.egg-info/

# ─── Uploads and generated files ───────────────────────────────────────────
# -----------------------------------------------------------------------------
# Local development storage
# -----------------------------------------------------------------------------
storage/
storage/raw/
storage/processed/
storage/temp/

# Uploaded models
*.ifc
*.ifczip
*.step
*.stp
*.iges
*.igs
*.obj
*.fbx
*.glb
*.gltf
*.stl

# Generated conversion outputs
*.xkt

# Temporary conversion files
*.tmp

# ─── Logs ──────────────────────────────────────────────────────────────────
*.log
**/logs/

# ─── Docker ────────────────────────────────────────────────────────────────
# docker-compose.override.yml is a local override — keep the main file committed
docker-compose.override.yml

# ─── IDEs ──────────────────────────────────────────────────────────────────
.vscode/
.idea/
**/*.iml
**/.DS_Store
**/Thumbs.db
*.swp
*.swo
*~

# ─── OS ────────────────────────────────────────────────────────────────────
.DS_Store
Desktop.ini